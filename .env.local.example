# ======================================================================
#  Ultra 3D Brasil — Loja / PDV  |  Variáveis de ambiente (Vercel)
#  Copie estes nomes em Vercel → Project ultra3d-loja → Settings →
#  Environment Variables. NÃO comitar valores reais (.env* é gitignored).
# ======================================================================

# ---- Supabase (banco) ----
# URL + anon já estão como fallback no código (públicas). A SERVICE ROLE
# é SECRETA — pegue em Supabase → projeto ultra3d-loja → Settings → API →
# "service_role" (secret) e cole aqui / no Vercel.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Painel / PDV ----
# Senha única de acesso ao /admin (escolha uma forte).
ADMIN_SENHA=

# ---- Asaas (pagamentos: Pix / cartão / boleto) — CNPJ novo ----
ASAAS_ENVIRONMENT=production        # sandbox | production
ASAAS_API_KEY=                      # chave da API do Asaas (SEM o "$" inicial)
ASAAS_WEBHOOK_TOKEN=                # token que você define no webhook do Asaas

# ---- Melhor Envio (frete + etiqueta) — CNPJ novo ----
MELHOR_ENVIRONMENT_SANDBOX=false
MELHOR_ENVIO_TOKEN=                 # token OAuth (Bearer) do Melhor Envio

# ---- Endereço de origem (remetente dos envios) ----
ORIGEM_NOME=Ultra 3D Brasil
ORIGEM_CNPJ=
ORIGEM_EMAIL=contato@ultra3dbrasil.com.br
ORIGEM_TELEFONE=
ORIGEM_CEP=
ORIGEM_RUA=
ORIGEM_NUMERO=
ORIGEM_BAIRRO=
ORIGEM_CIDADE=Maringá
ORIGEM_UF=PR
